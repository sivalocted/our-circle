# Public browser configuration. Add actual values only to your local ignored .env file
# and to the hosting provider's environment settings.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Legacy Supabase anon-key fallback supported by the current client.
VITE_SUPABASE_ANON_KEY=

# Payment keys belong only in a future Supabase Edge Function's server-side secrets.
# Never prefix these with VITE_ and never expose the secret in browser code.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
